{
  "name": "finance-app",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "licenses": "npm run licenses:prod && npm run licenses:dev",
    "licenses:prod": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;BlueOak-1.0.0\" --summary",
    "licenses:dev": "license-checker-rseidelsohn --development --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;BlueOak-1.0.0;Python-2.0;CC-BY-3.0;CC-BY-4.0;MPL-2.0\" --summary",
    "notices": "license-checker-rseidelsohn --production --excludePrivatePackages --markdown --out THIRD_PARTY_NOTICES.md"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
